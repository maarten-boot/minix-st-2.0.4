# Root file system of the rosco_m68k Minix boot image (src/rosco/tools/mkfs.py).
# Host paths are relative to src/rosco/boot, where mkfs.py runs.

d /dev 755
c /dev/console	622 4 0
c /dev/log	222 4 15
c /dev/tty00	666 4 16
c /dev/tty	666 5 0
b /dev/ram	600 1 0
c /dev/mem	640 1 1
c /dev/kmem	640 1 2
c /dev/null	666 1 3
c /dev/zero	644 1 4
b /dev/c0d0	600 3 0
b /dev/c0d0p0	600 3 1
b /dev/c0d0p1	600 3 2
b /dev/c0d0p2	600 3 3
b /dev/c0d0p3	600 3 4
b /dev/c0d1	600 3 5

d /etc 755
f /etc/rc	644 ../rootfs/etc/rc
f /etc/ttytab	644 ../rootfs/etc/ttytab
f /etc/passwd	644 ../rootfs/etc/passwd
f /etc/group	644 ../rootfs/etc/group
f /etc/utmp	644 ../rootfs/etc/utmp
f /etc/stamp	644 stamp
f /etc/hostname.file	644 ../rootfs/etc/hostname.file
f /etc/profile	644 ../rootfs/etc/profile
# the Minix termcap (src/etc/termcap) for clr, more, elvis, ...
f /etc/termcap	644 ../../etc/termcap

d /bin 755
# /bin/sh: rootfs/ramproto (the old Minix shell) or rootfs/sdproto (ash)
f /bin/cat	755 ../cmds/bin/cat
f /bin/cp	755 ../cmds/bin/cp
f /bin/date	755 ../cmds/bin/date
f /bin/asktime	755 ../cmds/bin/asktime
f /bin/df	4755 ../cmds/bin/df
f /bin/echo	755 ../cmds/bin/echo
f /bin/getty	755 ../cmds/bin/getty
f /bin/kill	755 ../cmds/bin/kill
f /bin/login	755 ../cmds/bin/login
f /bin/ls	755 ../cmds/bin/ls
f /bin/mkdir	755 ../cmds/bin/mkdir
f /bin/mknod	755 ../cmds/bin/mknod
f /bin/mount	4755 ../cmds/bin/mount
f /bin/printroot	755 ../cmds/bin/printroot
f /bin/pwd	755 ../cmds/bin/pwd
f /bin/rmdir	755 ../cmds/bin/rmdir
f /bin/sleep	755 ../cmds/bin/sleep
f /bin/stty	755 ../cmds/bin/stty
f /bin/sync	755 ../cmds/bin/sync
f /bin/touch	755 ../cmds/bin/touch
f /bin/umount	4755 ../cmds/bin/umount
f /bin/uname	755 ../cmds/bin/uname
l /bin/arch	/bin/uname
# true and false: one script that looks at its name
f /bin/true	755 ../../commands/scripts/true.sh
l /bin/false	/bin/true
f /bin/wc	755 ../cmds/bin/wc

d /mnt 755
d /tmp 1777
d /usr 755
d /usr/adm 755
d /usr/bin 755
l /usr/bin/login	/bin/login
d /usr/lib 755
d /usr/tmp 1777
f /usr/lib/pwdauth	4755 ../cmds/bin/pwdauth
d /usr/ast 777
