# /etc/ttytab - terminals, rosco_m68k.
#
# name		type	getty			init
# The console is DUART channel A, tty00 is DUART channel B.  The accounts
# have no passwords yet (/etc/passwd); set them with passwd.
# The console is a serial terminal (emulator), hence vt100, not minix.
console		vt100	getty
tty00		vt100	getty
