# /etc/profile - read by login shells, rosco_m68k.

# Set timezone (as src/etc/profile).

TZ='GMT0'	export TZ

# The command search path, exported: ash (/bin/sh) has a default PATH but
# does not export it, so programs that run others with execvp() (man runs
# nroff, for instance) found nothing.
PATH=/usr/local/bin:/bin:/usr/bin	export PATH

# New files are not writable by others.  A login comes from init, getty
# and login, not from /etc/rc, so it would have the kernel's umask 0.

umask 022

# Interrupt with Ctrl-C, as most terminals expect, instead of the Minix
# default DEL, and erase with DEL, which is what the Backspace key of most
# terminal programs sends (the Minix default is ^H).  The tty resets this
# on the last close, so every login sets it again.

stty intr '^C' erase '^?'
