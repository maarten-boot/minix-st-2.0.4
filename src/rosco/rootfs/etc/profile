# /etc/profile - read by login shells, rosco_m68k.

# Set timezone (as src/etc/profile).

TZ='GMT0'	export TZ

# Interrupt with Ctrl-C, as most terminals expect, instead of the Minix
# default DEL, and erase with DEL, which is what the Backspace key of most
# terminal programs sends (the Minix default is ^H).  The tty resets this
# on the last close, so every login sets it again.

stty intr '^C' erase '^?'
