+#define CHARTYPE(c)	((unsigned char) (c) < 128 ? chartype[(c)] : 0)
+
+/* rosco: stop at the end of token[] (an identifier, number or operator
+   of 200 or more characters ran over the globals behind it) */
+#define CHECK_TOK	if (tok >= token + tokbufsize - 4) tok_too_long()
+
+static void
+tok_too_long()
+{
+   diag(1, "Token too long");
+   fflush(output);
+   exit(1);
+}
