 	  {
-	once:	strcat(strcat(strcpy(sfname,homedir),"/+"),b->b_name);
+	once:	/* rosco: no HOME (NULL), or a name that does not fit */
+		if(!homedir || strlen(homedir)+2+strlen(b->b_name) >= FNAMSIZ)
+		  {	if(grunt) printf("Cannot save %s: no HOME or too long\n",
+					b->b_name);
+			continue;
+		  }
+		strcat(strcat(strcpy(sfname,homedir),"/+"),b->b_name);
