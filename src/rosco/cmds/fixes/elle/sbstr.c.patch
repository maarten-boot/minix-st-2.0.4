 extern struct smblk *sbm_list;
+
+/* rosco: sbm_nfor() passes its last argument on as a 4-byte pointer (its
+** prototype), and sbx_sdgc() read the level from the first 2 bytes of it,
+** the high half: always 0.  So the GC never got past level 0: no modified
+** text was ever written to the swapout file, and editing more than about
+** 50K ended with "GC loop, cannot free block" (and a Memory fault).
+** This takes the pointer and passes the level on as an int.
+*/
+static int
+sbx_sdgcp(sdp, levp)
+struct sdblk *sdp;
+struct sbfile *levp;
+{	return(sbx_sdgc(sdp, (int)(long)levp));
+}
+
 sbx_comp(cmin,lev)
 int cmin, lev;
 {	int sbx_sdgc();
@@ -1721,7 +1736,8 @@
 				cmin));
 
