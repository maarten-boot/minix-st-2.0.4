-	sbm_nfor(SM_DNODS,sizeof(struct sdblk),sbx_sdgc,lev);
+	sbm_nfor(SM_DNODS,sizeof(struct sdblk),sbx_sdgcp,	/* rosco */
+		(struct sbfile *)(long)lev);
 }
 
