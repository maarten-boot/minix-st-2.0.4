+/* rosco: mail is setuid root, and the temporary file was opened with
+ * fopen(tempname, "w"), a name made from the pid when mail started.  Any
+ * user could create it first, or link it to a system file, and have root
+ * write the letter or the whole maildrop into it (and the file was mode
+ * 644).  Make a fresh name and create the file exclusively, mode 600.
+ */
+FILE *opentemp()
+{
+  int fd, tries;
+
+  for (tries = 0; tries < 26; tries++) {
+	strcpy(tempname, "/tmp/mailXXXXXX");
+	if (strcmp(mktemp(tempname), "/") == 0) break;
+	fd = open(tempname, O_RDWR | O_CREAT | O_EXCL, 0600);
+	if (fd >= 0) return fdopen(fd, "w+");
+	if (errno != EEXIST) break;
+  }
+  return NULL;
+}
