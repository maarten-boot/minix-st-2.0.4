+/* rosco: a regular file owned by uid */
+int ownfile(struct stat *st, uid_t uid)
+{
+  return(S_ISREG(st->st_mode) && st->st_uid == uid);
+}
+
+/* rosco: a login name: letters, digits, '.', '_', '-', not too long and
+ * not starting with '-'
+ */
+int goodname(s)
+char *s;
+{
+  char *p;
+
+  if (*s == '\0' || *s == '-' || strlen(s) > 64) return(0);
+  for (p = s; *p != '\0'; p++) {
+	if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
+	      (*p >= '0' && *p <= '9') || *p == '.' || *p == '_' || *p == '-'))
+		return(0);
+  }
+  return(1);
+}
