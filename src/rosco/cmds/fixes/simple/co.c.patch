+/* rosco: run prog with up to three arguments, standard input from in and
+ * standard output to out if not NULL; returns its exit status (-1: could
+ * not run it).  Replaces system(), see extract().
+ */
+int run(in, out, prog, a1, a2, a3)
+char *in, *out, *prog, *a1, *a2, *a3;
+{
+  int pid, r, fd;
+
+  fflush(stdout);
+  fflush(stderr);
+  switch (pid = fork()) {
+      case -1:
+	perror("co: fork");
+	return(-1);
+      case 0:
+	if (in != NULL) {
+		if ((fd = open(in, O_RDONLY)) < 0 || dup2(fd, 0) < 0) {
+			perror(in);
+			_exit(1);
+		}
+		close(fd);
+	}
+	if (out != NULL) {
+		if ((fd = open(out, O_WRONLY | O_CREAT | O_TRUNC, 0644)) < 0
+							|| dup2(fd, 1) < 0) {
+			perror(out);
+			_exit(1);
+		}
+		close(fd);
+	}
+	execlp(prog, prog, a1, a2, a3, (char *) NULL);
+	perror(prog);
+	_exit(1);
+  }
+  while ((r = wait(&status)) != pid && r != -1)
+	;
+  if (r == -1) return(-1);
+  return(status);
+}
+
+/* rosco: if the last line of the SVC file is a lock, put the user in who
+ * and return 1
+ */
+int lockedby(who, size)
+char *who;
+int size;
+{
+  FILE *fp;
+  int locked = 0, rev;
+  char fmt[20];
+
+  if (NULL == (fp = fopen(svc, "r"))) return(0);
+  while (NULL != fgets(line, LINELEN, fp))
+	locked = !strncmp(line, "#***SVCLOCK*** ", (size_t)15);
+  fclose(fp);
+  if (!locked) return(0);
+  sprintf(fmt, "%%%ds %%d", size - 1);
+  if (2 != sscanf(line + 15, fmt, who, &rev)) strcpy(who, "?");
+  return(1);
+}
