+
+/* rosco: create a new file that must not exist yet (O_EXCL: no symbolic
+ * link followed, no other check-in's file taken over), for writing
+ */
+FILE *tmpcreate(name, mode)
+char *name;
+int mode;
+{
+  int fd;
+  FILE *fp;
+
+  if ((fd = open(name, O_WRONLY | O_CREAT | O_EXCL, mode)) < 0) return(NULL);
+  if (NULL == (fp = fdopen(fd, "w"))) {
+	close(fd);
+	unlink(name);
+  }
+  return(fp);
+}
