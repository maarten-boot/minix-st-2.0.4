+/* rosco: read one line into buff.  A line longer than buff came back in
+ * pieces that getold() and getnew() counted as lines, which put the
+ * context out of step with the line numbers of diff; truncate it instead.
+ */
+char *getlin(fp)
+FILE *fp;
+{
+  size_t n;
+  int c;
+
+  if (fgets(buff, sizeof buff, fp) == Nullch) return Nullch;
+  n = strlen(buff);
+  if (n == sizeof buff - 1 && buff[n - 1] != '\n'
+      && (c = getc(fp)) != EOF) {
+	while (c != '\n' && c != EOF) c = getc(fp);
+	buff[n - 1] = '\n';
+  }
+  return buff;
+}
+
+/* rosco: make room for need bytes in a hunk.  Doubling the 16-bit size_t
+ * wrapped to 0 after 32K (realloc to 0 bytes, then strcpy past the end).
+ */
+char *roomfor(hunk, allocp, need)
+char *hunk;
+size_t *allocp;
+long need;
+{
+  if (need < *allocp) return hunk;
+  while (need >= *allocp) {
+	if (*allocp == (size_t) -1) fatal_error("hunk too large", "");
+	*allocp = *allocp > (size_t) -1 / 2 ? (size_t) -1 : *allocp * 2;
+  }
+  return (char *) xrealloc(hunk, *allocp);
+}
