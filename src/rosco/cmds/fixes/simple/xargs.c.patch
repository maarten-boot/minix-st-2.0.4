+#if __minix && !__minix_vmd
+	/*
+	 * rosco: the exec frame (execve() and MM take ARG_MAX, 4096 bytes)
+	 * holds the strings, a 4-byte pointer for each argument and the
+	 * environment as well, which "ARG_MAX - 1K" left out: 200 arguments
+	 * of 14 characters with an ordinary environment gave "Arg list too
+	 * long" (exit 126).  Reserve the environment and the pointers.  A
+	 * large -n also overflowed the 16-bit malloc() size of the pointer
+	 * table below (-n 16384 got 8 bytes), so -n is capped at what can
+	 * fit, and -s at what is left (POSIX: the largest that fits).
+	 */
+	{
+		extern char **environ;
+		char **ep;
+		long room;
+
+		room = ARG_MAX - sizeof(long) - 3 * sizeof(char *);
+		for (ep = environ; ep && *ep; ep++)
+			room -= strlen(*ep) + 1 + sizeof(char *);
+		room -= (argc ? argc : 1) * sizeof(char *);
+		if (room < 2 + sizeof(char *))
+			err("environment too large");
+		if (nargs > room / (2 + sizeof(char *)))
+			nargs = room / (2 + sizeof(char *));
+		room -= (long) nargs * sizeof(char *);
+		if (nline > room)
+			nline = room;
+	}
+#endif
