 #define MUTABLE   1		/* Symbol can change defined <-> undefined */
 #define IMMUTABLE 2		/* Symbol can't change as above            */
 
+/* rosco: the size of the word buffers (80: a longer word overran them) */
+#define WORDLEN	512
+
 /* Processing modes */
 #define NO	0		/* Don't process */
 #define YES	1		/* Process */
@@ -77,21 +80,34 @@
   int ch;			/* args left in file.                */
   int i;
 
+  /* rosco: a word was copied into the 80-byte buffers without a bound,
+   * and at end of file (a last line "#endif" without newline) the copy
+   * loop never ended: it wrote EOF bytes up the stack.  Words are now cut
+   * at WORDLEN - 1 (with a message), and end of file ends a line: '\n' is
+   * returned instead of EOF, which was printed as a 0xFF byte.
+   */
   i = 0;
   cbuf[i] = 0;
 
   while (((ch = fgetc(stream)) == ' ') || (ch == '\t') || (ch == '\n'))
 	if (ch == '\n') return(ch);	/* Bypass leading */
 					/* Whitespace     */
-  if (feof(stream)) return(EOF);
+  if (ch == EOF) return('\n');
 
   cbuf[i++] = ch;
 
-  while (((ch = fgetc(stream)) != ' ') && (ch != '\t') && (ch != '\n'))
-	cbuf[i++] = ch;			/* Get the argument */
+  while (((ch = fgetc(stream)) != ' ') && (ch != '\t') && (ch != '\n')
+							&& (ch != EOF)) {
+	if (i < WORDLEN - 1)
+		cbuf[i++] = ch;		/* Get the argument */
+	else if (i++ == WORDLEN - 1)
+		(void)fprintf(stderr, "ifdef: line %d: word cut at %d characters\n",
+			line, WORDLEN - 1);
+  }
+  if (i > WORDLEN - 1) i = WORDLEN - 1;
 
   cbuf[i] = 0;
-  return(ch);
+  return(ch == EOF ? '\n' : ch);
 }
 
 
