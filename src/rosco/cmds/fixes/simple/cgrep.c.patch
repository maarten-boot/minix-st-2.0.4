+/* rosco: the number argument of an option */
+int optnum(aptr, min, max)
+char *aptr;
+int min, max;
+{
+  long n;
+  char *end;
+
+  if (aptr == NULL) {
+	fprintf(stderr, "cgrep: option needs a number\n");
+	exit(1);
+  }
+  n = strtol(aptr, &end, 10);
+  if (end == aptr || *end != NUL || n < min || n > max) {
+	fprintf(stderr, "cgrep: bad number %s (%d to %d)\n", aptr, min, max);
+	exit(1);
+  }
+  return (int) n;
+}
+
+/* rosco: calloc() results were not checked */
+void *xcalloc(n, size)
+size_t n, size;
+{
+  void *p;
+
+  if ((p = calloc(n, size)) == NULL) {
+	fprintf(stderr, "cgrep: out of memory\n");
+	exit(1);
+  }
+  return p;
+}
