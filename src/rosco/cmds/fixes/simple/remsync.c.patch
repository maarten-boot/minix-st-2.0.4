+int unsafe(const char *path, size_t trunc)
+/* rosco: the names in a file of differences were used as they were: "add
+ * ../../etc/x", or a name under a symlink, wrote outside the tree (remsync
+ * is run as root to apply them).  True if a name below the tree has a
+ * "." or ".." component or goes through something that is not a
+ * directory.
+ */
+{
+	char *copy= copystr(path);
+	char *p= copy + trunc, *c;
+	struct stat st;
+	int bad= 0;
+
+	for (;;) {
+		while (*p == '/') p++;
+		if (*p == 0) break;
+		c= p;
+		while (*p != 0 && *p != '/') p++;
+		if ((p - c == 1 && c[0] == '.')
+			|| (p - c == 2 && c[0] == '.' && c[1] == '.')) {
+			bad= 1;
+			break;
+		}
+		if (*p == 0) break;
+		*p= 0;
+		if (lstat(copy, &st) == 0 && !S_ISDIR(st.st_mode)) {
+			bad= 1;
+			break;
+		}
+		*p= '/';
+	}
+	deallocate(copy);
+	if (bad) {
+		fprintf(stderr, "remsync: %s: unsafe name, skipped\n", path);
+		excode= 1;
+	}
+	return bad;
+}
