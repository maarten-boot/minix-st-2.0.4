+/* rosco: read a whole line into l; NULL at the end of the file */
+char *readline(fp, l)
+FILE *fp;
+Line *l;
+{
+  unsigned n = 0;
+
+  if (l->b == NULL) {
+	l->size = LINELEN;
+	if ((l->b = (char *) malloc(l->size)) == NULL) fatal("out of memory");
+  }
+  for (;;) {
+	if (fgets(l->b + n, (int) (l->size - n), fp) == NULL)
+		return(n == 0 ? (char *) NULL : l->b);
+	n += strlen(l->b + n);
+	if (n > 0 && l->b[n - 1] == '\n') return(l->b);
+	if (n + 1 < l->size) return(l->b);	/* last line, no newline */
+	if (l->size >= 0x8000) fatal("line longer than %u characters", l->size - 1);
+	l->size *= 2;
+	if ((l->b = (char *) realloc(l->b, l->size)) == NULL)
+		fatal("out of memory");
+  }
+}
