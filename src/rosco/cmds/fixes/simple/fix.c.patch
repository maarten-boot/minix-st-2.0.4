+/* rosco: line numbers were int (16 bits): a diff of line 40000 was taken
+ * as line -25536 ("delete line conflict" against line 1).  Lines were
+ * read with fgets() into 1024 byte buffers: a longer line counted as two
+ * or more, and the next change went to the wrong place (an "a" put the new
+ * line into the middle of the long one).  Lines now go into buffers that
+ * grow (up to 32K).
+ */
+typedef struct {
+  char *b;			/* the line */
+  unsigned size;		/* size of b */
+} Line;
+
+Line oline, nline, cline;	/* the file, the diff list, a command */
+
