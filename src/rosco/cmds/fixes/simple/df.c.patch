+  /* Don't allow Joe User to df just any device.  rosco: checked with
+   * access() (the real ids); seteuid() is setuid() here, so after the first
+   * unmounted device df had lost root for the mounted ones that followed
+   * ("df /dev/c0d0p3 /" as a user: "Permission denied" for the root).
+   */
+  if (*mt->mountpoint == 0 && (ruid != euid || rgid != egid)
+					&& access(mt->devname, R_OK) < 0) {
+	fprintf(stderr, "df: %s: %s\n", mt->devname, strerror(errno));
+	return(1);
+  }
 
   if ((fd = open(mt->devname, O_RDONLY)) < 0) {
 	fprintf(stderr, "df: %s: %s\n", mt->devname, strerror(errno));
@@ -380,14 +390,20 @@
   return(0);
 }
 
+/* rosco: the bit maps are arrays of bitchunk_t (16 bits) in the FS's byte
+ * order: bit n is bit n % 16 of word n / 16.  Counted by bytes, the last
+ * partial word was taken from the wrong byte on the 68000 (big endian),
+ * missing up to 15 bits at the end of the map.  Count by words.
+ */
 bit_t bit_count(unsigned blocks, bit_t bits, int fd)
 {
-  char *wptr;
-  int i, b;
+  bitchunk_t *wptr, *wlim;
+  int i, b, n;
   bit_t busy;
-  char *wlim;
-  static char buf[BLOCK_SIZE];
+  static bitchunk_t buf[BLOCK_SIZE / sizeof(bitchunk_t)];
   static char bits_in_char[1 << CHAR_BIT];
+#define CHUNK_BITS	(CHAR_BIT * sizeof(bitchunk_t))
+#define COUNT(w)	(bits_in_char[(w) & 0xFF] + bits_in_char[((w) >> 8) & 0xFF])
 
   /* Precalculate bitcount for each char. */
   if (bits_in_char[1] != 1) {
@@ -399,24 +415,28 @@
   /* Loop on blocks, reading one at a time and counting bits. */
   busy = 0;
   for (i = 0; i < blocks && bits != 0; i++) {
-	if (read(fd, buf, BLOCK_SIZE) != BLOCK_SIZE) return(-1);
+	if (read(fd, (char *) buf, BLOCK_SIZE) != BLOCK_SIZE) return(-1);
 
 	wptr = &buf[0];
 	if (bits >= CHAR_BIT * BLOCK_SIZE) {
-		wlim = &buf[BLOCK_SIZE];
+		wlim = &buf[BLOCK_SIZE / sizeof(bitchunk_t)];
 		bits -= CHAR_BIT * BLOCK_SIZE;
 	} else {
-		b = bits / CHAR_BIT;	/* whole chars in map */
-		wlim = &buf[b];
-		bits -= b * CHAR_BIT;	/* bits in last char, if any */
-		b = *wlim & ((1 << bits) - 1);	/* bit pattern from last ch */
-		busy += bits_in_char[b];
+		n = bits / CHUNK_BITS;	/* whole words in map */
+		wlim = &buf[n];
+		bits -= (bit_t) n * CHUNK_BITS;	/* bits in last word, if any */
+		if (bits != 0) {
+			b = *wlim & ((1 << (int) bits) - 1);
+			busy += COUNT(b);
+		}
 		bits = 0;
 	}
 
-	/* Loop on the chars of a block. */
-	while (wptr != wlim)
-		busy += bits_in_char[*wptr++ & ((1 << CHAR_BIT) - 1)];
+	/* Loop on the words of a block. */
+	while (wptr != wlim) {
+		b = *wptr++;
+		busy += COUNT(b);
+	}
   }
   return(busy);
 }
