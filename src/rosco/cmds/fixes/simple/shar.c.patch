+/* rosco: write a name in single quotes, a ' in it as '\'' */
+static void putname(name)
+char *name;
+{
+  putchar('\'');
+  for (; *name != '\0'; name++) {
+	if (*name == '\'')
+		fputs("'\\''", stdout);
+	else
+		putchar(*name);
+  }
+  putchar('\'');
+}
