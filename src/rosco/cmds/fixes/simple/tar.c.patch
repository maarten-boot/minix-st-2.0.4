+/* rosco: does data follow the header?  Not for links, devices, fifos and
+ * directories (Minix tar wrote the file size into the header of a hard
+ * link); for regular, contiguous ('7') and unknown types (GNU 'L', 'x'...).
+ */
+int has_data()
+{
+  int n = 0;
+
+  switch (header.dbuf.typeflag) {
+      case '1': case '2': case '3': case '4': case '5': case '6':
+	return 0;
+  }
+  while (n < NAMSIZ && header.dbuf.name[n] != 0) n++;
+  return !(n > 0 && header.dbuf.name[n - 1] == '/');
+}
