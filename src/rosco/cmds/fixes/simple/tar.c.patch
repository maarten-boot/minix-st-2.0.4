+/* rosco: names to extract: without leading '/', no ".." component */
+char *safe_name(name)
+char *name;
+{
+  char *p;
+  static int told = 0;
+
+  if (*name == '/') {
+	while (*name == '/') name++;
+	if (!told) string_print(NIL_PTR, "Removing leading '/' from names\n");
+	told = 1;
+  }
+  for (p = name; *p; ) {
+	if (p[0] == '.' && p[1] == '.' && (p[2] == '/' || p[2] == 0)) {
+		string_print(NIL_PTR, "%s: name contains \"..\", skipped\n",
+								name);
+		errors++;
+		return NIL_PTR;
+	}
+	while (*p && *p != '/') p++;
+	while (*p == '/') p++;
+  }
+  if (*name == 0) return NIL_PTR;
+  return name;
