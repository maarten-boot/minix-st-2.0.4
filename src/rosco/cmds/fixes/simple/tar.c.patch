+{
+  char *p;
+  struct stat st;
+  int r = 0;
+
+  for (p = file; (p = strchr(p, '/')) != NIL_PTR; p++) {
+	*p = 0;
+	r = (lstat(file, &st) == 0 && S_ISLNK(st.st_mode));
+	*p = '/';
+	if (r) {
+		string_print(NIL_PTR, "%s: not extracted through a symbolic link\n",
+								file);
+		errors++;
+		break;
+	}
+  }
+  return r;
+}
+
+/* Make the missing directories in the name of file (moved here from
+ * extract(), rosco: now also for directories and links).
