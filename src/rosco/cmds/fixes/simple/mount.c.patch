+/* rosco: mount is setuid root, and FS only checks the effective uid, so
+ * every user could mount any partition on any directory (over /etc, a
+ * file system with a setuid shell...).  A user other than root now needs
+ * access to the device (read, and write for read-write) and must own the
+ * directory; swap is root's only.
+ */
+void user_check(special, dir, ro)
+char *special;
+char *dir;
+int ro;
+{
+  struct stat st;
+  char *what, *err;
+
+  if (getuid() == 0) return;
+  if (dir == NULL) {
+	errno = EPERM;
+	what = special;
+  } else if (access(special, ro ? R_OK : R_OK | W_OK) < 0) {
+	what = special;
+  } else if (stat(dir, &st) < 0) {
+	what = dir;
+  } else if (st.st_uid != getuid()) {
+	errno = EPERM;
+	what = dir;
+  } else {
+	return;
+  }
+  err = strerror(errno);
+  std_err("mount: ");
+  std_err(what);
+  std_err(": ");
+  std_err(err);
+  std_err("\n");
+  exit(1);
+}
