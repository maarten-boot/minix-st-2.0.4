+/* rosco: a year or month argument: a decimal number from 0 to 9999, else
+ * "Bad argument".
+ */
+static int number(s)
+char *s;
+{
+  long n = 0;
+
+  if (*s == '\0') usage(badarg);
+  for (; *s != '\0'; s++) {
+	if (*s < '0' || *s > '9') usage(badarg);
+	n = n * 10 + (*s - '0');
+	if (n > 9999) usage(badarg);
+  }
+  return((int) n);
+}
