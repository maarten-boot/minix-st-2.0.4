   if (argc < 3) usage();
   p = argv[1];
   if (*p != '=' && *p != '+' && *p != '-') usage();
+  /* rosco: atol() took "=abc" or "=8k" as 0 (or 8): =abc set the stack
+   * to 0 bytes; only digits now
+   */
+  if (p[1] == '\0' || strspn(p + 1, "0123456789") != strlen(p + 1)
+						|| strlen(p + 1) > 9) {
+	error(p + 1, "is not a number of bytes");
