 	if (lsize > max) {
 		error("size is too large for", *argv);
+		close(fd);
 		continue;
 	}
 	olddynam = exec.a_total - exec.a_data - exec.a_bss;
@@ -103,6 +122,20 @@
 	else if (*p == '-')
