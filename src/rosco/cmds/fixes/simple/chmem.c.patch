+   * stack size is a_total, nothing else is changed
+   */
+  s = A_MINHDR;
 
   if (lsize < 0) {
 	error(p + 1, "is negative");
@@ -60,16 +74,19 @@
   while (--argc) {
 	++argv;
 	fd = open(*argv, O_RDWR);
+	/* rosco: errors exited 0 and left the file open (OPEN_MAX) */
 	if (fd < 0) {
 		error("can't open", *argv);
 		continue;
 	}
 	if (read(fd, (char *) &exec, s) != s) {
 		error("can't read header in", *argv);
+		close(fd);
 		continue;
 	}
 	if (BADMAG(exec)) {
