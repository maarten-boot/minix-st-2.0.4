+/* rosco: a block size in a 16-bit unsigned was cut (bs=64k was 0, and
+ * bs=100k 34464), and a read() or write() of more than 32767 bytes fails
+ * here (its count comes back in a 16-bit int), as does sbrk() of more.
+ */
+unsigned bsize()
+{
+  NUMBER n = num();
+
+  if (n > 32767) {
+	fprintf(stderr, "dd: argument %s out of range (at most 32767)\n",
+		errorp);
+	exit(1);
+  }
+  return((unsigned) n);
+}
