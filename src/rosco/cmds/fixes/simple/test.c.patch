+/* rosco: f1 -nt f2 (f1 newer, or only f1 exists), -ot (the reverse), -ef
+ * (the same file).
+ */
+int newer2(fil1, fil2, mode)
+char *fil1, *fil2;
+int mode;
+{
+  struct stat s1, s2;
+  int r1 = stat(fil1, &s1), r2 = stat(fil2, &s2);
+
+  switch (mode) {
+      case FILNT:
+	return r1 == 0 && (r2 != 0 || s1.st_mtime > s2.st_mtime);
+      case FILOT:
+	return r2 == 0 && (r1 != 0 || s1.st_mtime < s2.st_mtime);
+      case FILEF:
+	return r1 == 0 && r2 == 0 && s1.st_dev == s2.st_dev
+		&& s1.st_ino == s2.st_ino;
+  }
+  return 0;
+}
