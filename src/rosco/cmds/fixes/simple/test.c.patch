+/* rosco: up to 4 arguments are taken by their number, as POSIX says: an
+ * operand that looks like an operator is an operand ("test -n", "[ "$x" ]"
+ * with x=-f, "test ! = !", "test -n = y" were syntax errors or wrong).
+ */
+int posix(a, n)
+char **a;
+int n;
+{
+  int op;
+
+  switch (n) {
+      case 0:
+	return 0;
+      case 1:
+	return a[0][0] != '\0';
+      case 2:
+	if (strcmp(a[0], "!") == 0) return !posix(a + 1, 1);
+	if (lex(a[0]) != OPERAND && ip_op->op_type == UNOP)
+		return unary(ip_op->op_num, a[1]);
+	break;
+      case 3:
+	op = lex(a[1]);
+	if (op != OPERAND && ip_op->op_type == BINOP)
+		return binary(op, a[0], a[2]);
+	if (op == BAND) return a[0][0] != '\0' && a[2][0] != '\0';
+	if (op == BOR) return a[0][0] != '\0' || a[2][0] != '\0';
+	if (strcmp(a[0], "!") == 0) return !posix(a + 1, 2);
+	if (strcmp(a[0], "(") == 0 && strcmp(a[2], ")") == 0)
+		return posix(a + 1, 1);
+	break;
+      case 4:
+	if (strcmp(a[0], "!") == 0) return !posix(a + 1, 3);
+	if (strcmp(a[0], "(") == 0 && strcmp(a[3], ")") == 0)
+		return posix(a + 1, 2);
+	return -1;
+  }
+  syntax();
+  return 0;
+}
