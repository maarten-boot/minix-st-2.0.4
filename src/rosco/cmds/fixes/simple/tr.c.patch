+/* rosco: one character of a string, with the escapes \ooo, \\, \n, \t,
+ * \r, \b, \f, \a, \v (the old code gave "n" for \n) as a value 0-255.
+ */
+static int getch(argp)
+char **argp;
+{
+  register char *arg = *argp;
+  int c, i;
+
+  if (*arg != '\\' || arg[1] == '\0') {
+	c = *arg++ & 0377;
+  } else if (*++arg >= '0' && *arg <= '7') {
+	c = i = 0;
+	do {
+		c = (c << 3) + *arg++ - '0';
+	} while (++i < 3 && *arg >= '0' && *arg <= '7');
+	c &= 0377;
+  } else {
+	switch (c = *arg++ & 0377) {
+	    case 'n':	c = '\n';	break;
+	    case 't':	c = '\t';	break;
+	    case 'r':	c = '\r';	break;
+	    case 'b':	c = '\b';	break;
+	    case 'f':	c = '\f';	break;
+	    case 'a':	c = '\007';	break;
+	    case 'v':	c = '\v';	break;
+	}
+  }
+  *argp = arg;
+  return c;
+}
