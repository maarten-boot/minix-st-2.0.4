+/*
+ * rosco: append statement list p to list.  "{ a; b }" is the list a, b
+ * itself, and the next rule was linked to a, which lost b; a second
+ * BEGIN, or rules after a BEGIN, END or function, replaced the first.
+ */
+NODE *
+addstat(list, p) NODE *list, *p;
+{
+  NODE *q;
+
+  if (list == NULL)
+	return p;
+  for (q = list; q->n_next != NULL; q = q->n_next)
+	;
+  q->n_next = p;
+  return list;
+}
