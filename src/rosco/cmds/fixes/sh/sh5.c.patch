 /*
+ * rosco: filechar() for the pipe from `...`, which also waits for the
+ * process at the end of its output (its pid in afpos, see grave()).
+ * Nothing waited for it before: in a loop without other commands, as
+ * "while read l; do n=`expr $n + 1`; done", the zombies filled the
+ * process table and fork failed ("try again").
+ */
+static int
+gravefile(ap)
+register struct ioarg *ap;
+{
+	register int i;
+	char c;
+	int s;
+
+	if (ap->afid != AFID_NOBUF)
+		return(filechar(ap));
+	do {
+		i = read(ap->afile, &c, sizeof(c));
+	} while (i < 0 && errno == EINTR);
+	if (i == sizeof(c))
+		return(c&0177);
+	closef(ap->afile);
+	if (ap->afpos > 0) {
+		waitpid((pid_t) ap->afpos, &s, 0);
+		ap->afpos = 0;
+	}
+	return(0);
+}
+
