+/*
+ * rosco: copy of the words wp[0] .. wp[n-1], NULL terminated, with
+ * the strings in the same cell (in the current area)
+ */
+static char **
+copywords(wp, n)
+register char **wp;
+int n;
+{
+	register char **nv, *cp;
+	register int i;
+	unsigned len;
+
+	len = (n+1) * sizeof(char *);
+	for (i = 0; i < n; i++)
+		len += strlen(wp[i]) + 1;
+	if ((nv = (char **) space(len)) == NULL)
+		return((char **)NULL);
+	cp = (char *)(nv + n + 1);
+	for (i = 0; i < n; i++) {
+		nv[i] = strcpy(cp, wp[i]);
+		cp += strlen(cp) + 1;
+	}
+	nv[n] = NULL;
+	return(nv);
+}
