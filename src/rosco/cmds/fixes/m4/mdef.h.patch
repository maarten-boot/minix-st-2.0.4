--- m4/mdef.h
+++ m4/mdef.h
@@ -115,9 +115,14 @@
 #define MAXINP          10              /* maximum include files   */
 #define MAXOUT          10              /* maximum # of diversions */
 #define MAXSTR          512             /* maximum size of string  */
-#define BUFSIZE         4096            /* size of pushback buffer */
-#define STACKMAX        1024            /* size of call stack      */
-#define STRSPMAX        4096            /* size of string space    */
+/* rosco: the pushback buffer and the string space (all macro arguments
+ * being collected) were 4K, the call stack 1024 entries (about 170 nested
+ * calls); now 32000 bytes each and 4096 entries.  The string space stays
+ * below 32K: lengths and indexes into it are 16-bit ints (len, index).
+ */
+#define BUFSIZE         32000           /* size of pushback buffer */
+#define STACKMAX        4096            /* size of call stack      */
+#define STRSPMAX        32000           /* size of string space    */
 #define MAXTOK          MAXSTR          /* maximum chars in a tokn */
 #define HASHSIZE        199             /* maximum size of hashtab */
  
@@ -165,10 +170,18 @@
  *      pushf() - push a call frame entry onto stack
  *      pushs() - push a string pointer onto stack
  */
-#define gpbc() 	 (bp > buf) ? *--bp : getc(infile[ilevel])
+/* rosco: a pushed back character is read as unsigned: a byte 0xFF came
+ * back as -1, EOF, and ended the input.  The callers no longer push back
+ * EOF (end of file is sticky in stdio).  pushf()/pushs() silently dropped
+ * entries on a full call stack, which then corrupted the frames; now an
+ * error.
+ */
+#define gpbc() 	 ((bp > buf) ? (*--bp & 0xFF) : getc(infile[ilevel]))
 #define min(x,y) ((x > y) ? y : x)
-#define pushf(x) if (sp < STACKMAX) mstack[++sp].sfra = (x)
-#define pushs(x) if (sp < STACKMAX) mstack[++sp].sstr = (x)
+#define pushf(x) do { if (sp < STACKMAX) mstack[++sp].sfra = (x); \
+		      else error("m4: internal stack overflow"); } while (0)
+#define pushs(x) do { if (sp < STACKMAX) mstack[++sp].sstr = (x); \
+		      else error("m4: internal stack overflow"); } while (0)
 
