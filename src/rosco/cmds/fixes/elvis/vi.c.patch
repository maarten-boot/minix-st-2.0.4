 #include "ctype.h"
 #include "vi.h"
 
+/* rosco: the bell for an ESC in command mode.  beep() also discards the
+ * type-ahead (to abort a macro), and ESC waits "keytime" (1 s) for the
+ * rest of an arrow key, so keys typed right after it were read with it
+ * and lost: on the board ESC (twice, or in command mode) followed by ":"
+ * did nothing, an arrow key first "helped".  vi keeps them.
+ */
+static void escbell()
+{
+	if (*o_flash)
+	{
+		do_VB();
+		refresh();
+	}
+	else if (*o_errorbells)
+	{
+		ttywrite("\007", 1);
+	}
+}
+
 
 
