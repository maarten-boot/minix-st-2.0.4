+/* rosco: the client's names and arguments go to "sh -c" (LIST, NLST,
+ * STAT, SITE CRC, RETR of name.tar and so on): "LIST ;cmd" ran any
+ * command.  Only characters that the shell takes as plain text or as a
+ * wildcard may pass.
+ */
+static int shellsafe(s)
+char *s;
+{
+   for(; *s; s++)
+	if(!(isalnum((unsigned char)*s)
+				|| strchr(" \t._-+/,=:@%~*?[]#", *s) != NULL))
+		return(0);
+   return(1);
+}
