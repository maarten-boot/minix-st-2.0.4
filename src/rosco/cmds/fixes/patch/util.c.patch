+
+/* rosco: create a temporary file in /tmp safely.  The names are mktemp()'s
+ * (the pid), easy to guess, and were opened with fopen(.., "w") or creat():
+ * a symbolic link planted under such a name made patch (often run as
+ * root) create or overwrite the file it pointed to.  Remove what is there,
+ * create the file exclusively (mode 0600) and check that the name is that
+ * file.  (This FS follows a symbolic link even with O_EXCL; the unlink()
+ * before it leaves only a race.)
+ */
+int
+tmpcreat(name)
+char *name;
+{
+    int fd;
+    struct stat st, lst;
+
+    Unlink(name);
+    fd = open(name, O_WRONLY | O_CREAT | O_EXCL, 0600);
+    if (fd < 0)
+	fatal("patch: can't create %s.\n", name);
+    if (fstat(fd, &st) < 0 || lstat(name, &lst) < 0 || !S_ISREG(lst.st_mode)
+	|| st.st_dev != lst.st_dev || st.st_ino != lst.st_ino
+	|| lst.st_nlink != 1) {
+	Close(fd);
+	fatal("patch: %s is not a new file, giving up.\n", name);
+    }
+    return fd;
+}
+
+FILE *
+tmpfopen(name)
+char *name;
+{
+    FILE *fp = fdopen(tmpcreat(name), "w");
+
+    if (fp == Nullfp)
+	fatal("patch: can't create %s.\n", name);
+    return fp;
+}
+
+/* rosco: a file name from the diff (Index:, ***, ---) that is absolute or
+ * has a ".." component reaches files outside the current directory: with
+ * -p0 (or a directory that exists, fetchname) "../../etc/passwd" or
+ * "/etc/passwd" was patched.  Such names are not used, as GNU patch does.
+ */
+bool
+safe_name(name)
+char *name;
+{
+    char *s;
+
+    if (name == Nullch)
+	return TRUE;
+    if (*name == '/')
+	return FALSE;
+    for (s = name; *s; ) {
+	if (s[0] == '.' && s[1] == '.' && (s[2] == '/' || s[2] == '\0'))
+	    return FALSE;
+	while (*s && *s != '/')
+	    s++;
+	while (*s == '/')
+	    s++;
+    }
+    return TRUE;
+}
