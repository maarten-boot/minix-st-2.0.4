+	 * a last line without a newline is returned as a line (reader.c)
+	 * with feof() already true, and was dropped.
+	 */
+	if ((eof = getline(&str2s, fd)) == FALSE) {	/*  Get commands  */
 		while (*str2 == TABCHAR) {
 			cp = newcmd(&str2[0], cp);
