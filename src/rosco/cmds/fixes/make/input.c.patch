   str2s.len = LZ2;
 }
 
+/* rosco: len is a 16-bit int: doubling 16384 gave -32768 (realloc of
+ * 32784 bytes, then of 16 bytes) and a line or expansion of more than
+ * 16K overwrote the heap.  Stop at STRMAX (with the 16 extra bytes below
+ * 32767) with an error instead.
+ */
+#define STRMAX	32000
+
 void strrealloc(strs)
 struct str *strs;
 {
-  strs->len *= 2;
+  if (strs->len >= STRMAX)
+	fatal("Line or macro expansion too long (more than 32000 characters)",
+							(char *)0,0);
+  strs->len = strs->len >= STRMAX / 2 ? STRMAX : strs->len * 2;
   *strs->ptr = (char *) realloc(*strs->ptr, strs->len + 16);
   if(*strs->ptr == (char *) NULL)
        fatal("No memory for string reallocation",(char *)0,0);
@@ -295,6 +305,7 @@
