 #include "h.h"
 #include <sys/wait.h>
 #include <unistd.h>
+#include <signal.h>
 
 _PROTOTYPE(static void tellstatus, (FILE *out, char *name, int status));
 
 static bool  execflag;
 
+/* rosco: errors seen under -k (main.c exits 1 for them, it exited 0) */
+bool errors = FALSE;
+
+/* rosco: interrupts.  An interrupt (or quit, hangup, terminate) while a
+ * command ran killed make with the command: a half-made target was left
+ * newer than its sources and the next make thought it up to date.  Now
+ * the signal is noted while a command runs (system() waits for the
+ * command to end), the target is made to look old as after an error,
+ * and make then dies of the same signal.
+ */
+static int sigs[] = { SIGINT, SIGQUIT, SIGHUP, SIGTERM };
+static int incmd;		/* a command is running */
+static int caught;		/* the signal caught while it ran */
+
+static void catcher(sig)
+int sig;
+{
+  if (incmd) {
+	caught = sig;
+	signal(sig, catcher);
+	return;
+  }
+  signal(sig, SIG_DFL);
+  kill(getpid(), sig);
+}
+
+static void catchsigs()
+{
+  static int done;
+  int i;
+
+  if (done) return;
+  done = 1;
+  for (i = 0; i < sizeof(sigs) / sizeof(sigs[0]); i++)
+	if (signal(sigs[i], SIG_IGN) != SIG_IGN)
+		signal(sigs[i], catcher);
+}
+
+static void interrupted(np)
+struct name *np;
+{
+  int sig = caught;
+
+  fflush(stdout);
+  if (!(np->n_flag & N_PREC) && makeold(np->n_name) == 0)
+	fprintf(stderr, "%s: interrupted, made '%s' look old.\n",
+							myname, np->n_name);
+  signal(sig, SIG_DFL);
+  kill(getpid(), sig);
+  exit(1);
+}
+
