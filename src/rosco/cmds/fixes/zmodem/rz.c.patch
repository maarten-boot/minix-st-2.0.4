 /*
+ * rosco: true iff a received name is absolute or has a ".." component.
+ */
+static int unsafe(name)
+char *name;
+{
+	register char *p;
+
+	if (name[0] == '/')
+		return TRUE;
+	for (p = name; *p; ) {
+		if (p[0] == '.' && p[1] == '.' && (p[2] == '/' || p[2] == '\0'))
+			return TRUE;
+		while (*p && *p != '/')
+			++p;
+		while (*p == '/')
+			++p;
+	}
+	return FALSE;
+}
+
+/*
+ * rosco: true iff a received name can be given to the shell (rzCOMMAND):
+ * letters, digits, '.', '_', '-', '+', ',', '/', not starting with '-'.
+ */
+static int pipesafe(name)
+char *name;
+{
+	register char *p;
+
+	if (name[0] == '-')
+		return FALSE;
+	for (p = name; *p; ++p)
+		if (!isalnum((unsigned char) *p) && !strchr("._-+,/", *p))
+			return FALSE;
+	return TRUE;
+}
