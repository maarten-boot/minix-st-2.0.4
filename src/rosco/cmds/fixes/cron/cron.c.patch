+static void clock_set_back(void)
+/* rosco: the clock was set back (date(1), there is no real-time clock).  The
+ * jobs were scheduled for the old time and would not run until the clock got
+ * there again, possibly hours or years later.  Schedule them from now.
+ */
+{
+	crontab_t *tab;
+	cronjob_t *job;
+
+	for (tab= crontabs; tab != nil; tab= tab->next) {
+		for (job= tab->jobs; job != nil; job= job->next) {
+			if (job->atjob) continue;
+			job->rtime= now;
+			job->late= 0;
+			if (job->pid == IDLE_PID) tab_reschedule(job);
+		}
+	}
+	tab_reap_job(NO_PID);	/* Recompute 'next'. */
+}
