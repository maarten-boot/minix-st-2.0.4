--- orig/cron/crontab.c
+++ new/cron/crontab.c
@@ -46,6 +46,30 @@
 	r= open(file, flags, 0666);
 	err= errno;
 	seteuid(safe_uid);
+#if __minix && !__minix_vmd
+	/* rosco: access() and open() each look the name up, a symlink may be
+	 * swapped in between.  Check that the open file is one the user may
+	 * read.
+	 */
+	if (r >= 0 && uid != 0 && getuid() != 0) {
+		struct stat st;
+		mode_t bit;
+
+		if (fstat(r, &st) < 0) {
+			err= errno;
+			close(r);
+			r= -1;
+		} else {
+			bit= st.st_uid == getuid() ? S_IRUSR
+				: st.st_gid == getgid() ? S_IRGRP : S_IROTH;
+			if (how == 'r' && !(st.st_mode & bit)) {
+				close(r);
+				r= -1;
+				err= EACCES;
+			}
+		}
+	}
+#endif
 	errno= err;
 	return r;
 }
