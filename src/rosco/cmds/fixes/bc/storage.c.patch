+/* rosco: the largest scale.  BC_SCALE_MAX is INT_MAX, 32767 here, and a
+   number holds at most 32767 digits (16-bit counts, see number.c): with
+   scale=32767 even 1/3 was too long.  30000 leaves room for 2767 integer
+   digits and the guard digits of sqrt() and the math library. */
+#define SCALE_MAX 30000
+
 
