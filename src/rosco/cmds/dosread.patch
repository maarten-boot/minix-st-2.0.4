+/* rosco: directory entries hold little endian shorts and longs; on a big
+ * endian machine swap them after reading and before writing (the same
+ * operation both ways).
+ */
+void dir_conv(dir, entries)
+DIRECTORY *dir;
+int entries;
+{
+  if (!big_endian) return;
+  for (; entries > 0; entries--, dir++) {
+	dir->d_time = (dir->d_time >> 8) | (dir->d_time << 8);
+	dir->d_date = (dir->d_date >> 8) | (dir->d_date << 8);
+	dir->d_cluster = (dir->d_cluster >> 8) | (dir->d_cluster << 8);
+	dir->d_size = ((dir->d_size >> 24) & 0xFFL)
+		| ((dir->d_size >> 8) & 0xFF00L)
+		| ((dir->d_size << 8) & 0xFF0000L)
+		| ((dir->d_size << 24) & 0xFF000000L);
+  }
+}
